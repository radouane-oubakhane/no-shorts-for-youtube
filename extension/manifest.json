{
  "manifest_version": 3,
  "name": "No Shorts for YouTube",
  "short_name": "No Shorts",
  "version": "2.0.0",
  "description": "Hide YouTube Shorts from feeds, search, channels and navigation. Stay focused on the videos you choose.",
  "minimum_chrome_version": "105",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "No Shorts for YouTube",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "css": [
        "src/hide-shorts.css"
      ],
      "run_at": "document_start"
    }
  ]
}
